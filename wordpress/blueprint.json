{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "login": true,
  "steps": [
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/julianZamudio1/brisa-solar",
        "ref": "main",
        "path": "wordpress/brisa-solar"
      },
      "options": { "activate": true }
    },
    { "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; brisa_importar_demo();" }
  ]
}
