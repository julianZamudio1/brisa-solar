---
import '@fontsource-variable/figtree/wght.css';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '../styles/main.scss';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import fotoOg from '../assets/fotos/hero-instalador.jpg';
import { config, sitio } from '../data/sitio';
import Consentimiento from '../components/Consentimiento.astro';

interface Props {
  titulo: string;
  descripcion?: string;
  indexar?: boolean;
  esquema?: Record<string, unknown>[];
}

const { titulo, descripcion = sitio.descripcion, indexar = true, esquema = [] } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: fotoOg, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);
const gtmId = config.gtmId;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {!indexar && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f4f7f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b151c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />

    <!-- Tema antes de pintar para evitar el parpadeo claro/oscuro. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var guardado = null;
        try { guardado = localStorage.getItem('tema'); } catch (e) {}
        var oscuro = guardado ? guardado === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        d.setAttribute('data-bs-theme', oscuro ? 'dark' : 'light');
      })();
    </script>

    <!-- Google Consent Mode v2: todo denegado hasta que el visitante decida. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      var consentimiento = null;
      try { consentimiento = JSON.parse(localStorage.getItem('consentimiento') || 'null'); } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      if (consentimiento) {
        gtag('consent', 'update', {
          analytics_storage: consentimiento.analitica ? 'granted' : 'denied',
          ad_storage: consentimiento.publicidad ? 'granted' : 'denied',
          ad_user_data: consentimiento.publicidad ? 'granted' : 'denied',
          ad_personalization: consentimiento.publicidad ? 'granted' : 'denied',
        });
      }
    </script>

    {
      gtmId && (
        <script is:inline define:vars={{ gtmId }}>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', gtmId);
        </script>
      )
    }

    {esquema.map((dato) => <script type="application/ld+json" set:html={JSON.stringify(dato)} />)}
  </head>
  <body>
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <a class="enlace-saltar" href="#contenido">Saltar al contenido</a>
    <slot />
    <Consentimiento />
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>
