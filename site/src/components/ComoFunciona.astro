---
import Icono from './Icono.astro';
import VideoYoutube from './VideoYoutube.astro';
import poster from '../assets/fotos/proceso-cableado.jpg';

const pasos = [
  {
    icono: 'ruler',
    titulo: 'Visita técnica',
    texto: 'Revisamos tu techo, la orientación, las sombras y tu historial de consumo. Sin costo.',
  },
  {
    icono: 'blueprint',
    titulo: 'Diseño y cotización',
    texto: 'Te entregamos el diseño del sistema, la cotización cerrada y opciones de pago.',
  },
  {
    icono: 'wrench',
    titulo: 'Instalación',
    texto: 'Nuestro equipo instala paneles, inversor y protecciones en uno o dos días.',
  },
  {
    icono: 'plugs-connected',
    titulo: 'Interconexión con CFE',
    texto: 'Hacemos el trámite y CFE cambia tu medidor por uno bidireccional.',
  },
];
---

<section id="como-funciona" class="seccion" aria-labelledby="como-titulo">
  <div class="container">
    <h2 id="como-titulo" class="seccion-titulo mb-3" data-revelar>De la visita al ahorro en tres semanas</h2>
    <p class="seccion-texto mb-5" data-revelar>Nos encargamos de todo el proceso. Tú solo eliges la fecha de la visita.</p>

    <ol class="pasos list-unstyled">
      {
        pasos.map((p, i) => (
          <li data-revelar style={`--orden: ${i}`}>
            <span class="paso-icono">
              <Icono nombre={p.icono} />
            </span>
            <h3 class="h5 mt-3 mb-2">{p.titulo}</h3>
            <p class="text-body-secondary mb-0">{p.texto}</p>
          </li>
        ))
      }
    </ol>

    <figure class="mt-5 mb-0" data-revelar>
      <VideoYoutube
        id="xKxrkht7CpY"
        titulo="¿Cómo funcionan los paneles solares?"
        poster={poster}
        alt="Manos con guantes conectando el cableado de un sistema solar en un techo"
      />
      <figcaption class="small text-body-secondary mt-2">
        ¿Cómo funcionan los paneles solares? Video de TED-Ed con subtítulos en español.
      </figcaption>
    </figure>
  </div>
</section>
