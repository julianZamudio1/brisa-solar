---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import { ruta } from '../data/sitio';
---

<Base titulo="Página no encontrada | Brisa Solar" indexar={false}>
  <Encabezado enlacesInternos={false} />
  <main id="contenido" class="seccion">
    <div class="container" style="max-width: 40rem">
      <h1 class="seccion-titulo mb-3">Esta página no existe</h1>
      <p class="seccion-texto mb-4">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      <div class="d-flex flex-wrap gap-3">
        <a class="btn btn-primary btn-lg" href={ruta() + '#calculadora'}>Calcular mi ahorro</a>
        <a class="btn btn-outline-secondary btn-lg" href={ruta()}>Ir al inicio</a>
      </div>
    </div>
  </main>
  <Pie />
</Base>
